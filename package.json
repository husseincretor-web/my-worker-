{
  "name": "arabic-store-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute arabic-store-db --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute arabic-store-db --remote --file=./migrations/0001_init.sql",
    "db:seed:local": "wrangler d1 execute arabic-store-db --local --file=./migrations/0002_seed.sql",
    "db:seed:remote": "wrangler d1 execute arabic-store-db --remote --file=./migrations/0002_seed.sql"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "wrangler": "^3.99.0",
    "typescript": "^5.7.2",
    "@cloudflare/workers-types": "^4.20250101.0"
  }
}
